{
  "manifest_version": 3,
  "key": "",
  "name": "One Ramp",
  "version": "0.4.0",
  "description": "Verify Ramp expenses in one click: finds the matching receipt email in your Gmail and attaches receipt + memo to unverified charges.",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://api.ramp.com/*",
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://*.stripe.com/*",
    "https://api.anthropic.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.ramp.com/*"],
      "js": ["content.js"],
      "css": ["ui.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "One Ramp",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "web_accessible_resources": [
    { "resources": ["icons/icon-32.png"], "matches": ["https://app.ramp.com/*"] }
  ],
  "oauth2": {
    "client_id": "607338298511-p29b50jo4p2g5qp0rqghj4p3tu8i2q2u.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  }
}
